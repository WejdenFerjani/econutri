{% extends 'base.html.twig' %}

{% block title %}Mes Commandes - EcoNutri{% endblock %}

{% block body %}

<section class="order-hero" style="background-image: url('{{ asset('images/cammandes.jpg') }}');">
    <div class="container">
        <h1 class="order-hero-title">Mes Commandes</h1>
    </div>
</section>

<div class="container mt-4">
    {% if orders is empty %}
        <div class="alert alert-info">
            <p>Vous n'avez pas encore de commande.</p>
            <a href="{{ path('app_home') }}" class="btn btn-primary">Commencer vos achats</a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-header-cart">
                    <tr>
                        <th>N° Commande</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                    <tr>
                        <td>#{{ order.id }}</td>
                        <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                        <td>{{ order.grandTotal }} TND</td>
                        <td>
                            {% if order.status == 'pending' %}
                                <span class="badge bg-warning">En attente</span>
                            {% elseif order.status == 'confirmed' %}
                                <span class="badge bg-info">Confirmée</span>
                            {% elseif order.status == 'delivered' %}
                                <span class="badge bg-success">Livrée</span>
                            {% else %}
                                <span class="badge bg-danger">Annulée</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_order_details', {'id': order.id}) }}" class="btn btn-sm btn-primary">Détails</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>


<style>
/* Order Hero Section */
.order-hero {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 3rem;
}

.order-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
}

.order-hero-title {
    color: white;
    font-size: 3.5rem;
    font-weight: bold;
    position: relative;
    z-index: 1;
    text-align: center;
}

/* Modern Table */
.table-responsive {
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    overflow: hidden;
    margin-bottom: 2rem;
}

.table {
    margin-bottom: 0;
    border: none;
}

.table-header-cart {
    background: linear-gradient(135deg, #6ba75c, #4a8c3a) !important;
    color: white;
    border: none;
}

.table-header-cart th {
    border: none;
    padding: 1.25rem;
    font-weight: 600;
    font-size: 1rem;
    text-align: center;
}

.table tbody tr {
    transition: all 0.3s ease;
    text-align: center;
}

.table tbody tr:hover {
    background: #f8f9fa;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.table tbody td {
    padding: 1.25rem;
    vertical-align: middle;
    border-bottom: 1px solid #e9ecef;
}

/* Modern Badges */
.badge {
    padding: 0.6rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.85rem;
}

.bg-warning {
    background: linear-gradient(135deg, #ffc107, #e0a800) !important;
}

.bg-info {
    background: linear-gradient(135deg, #17a2b8, #138496) !important;
}

.bg-success {
    background: linear-gradient(135deg, #28a745, #1e7e34) !important;
}

.bg-danger {
    background: linear-gradient(135deg, #dc3545, #c82333) !important;
}

/* Modern Buttons */
.btn-primary {
    background: linear-gradient(135deg, #6ba75c, #4a8c3a);
    border: none;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 2px 10px rgba(107, 167, 92, 0.3);
}

.btn-primary:hover {
    background: linear-gradient(135deg, #5a9048, #3a7c2a);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(107, 167, 92, 0.4);
}

/* Alert Styling */
.alert-info {
    border: none;
    border-radius: 16px;
    background: linear-gradient(135deg, #cce7ff, #b3d9ff);
    color: #004085;
    box-shadow: 0 4px 15px rgba(0, 64, 133, 0.1);
    border-left: 6px solid #17a2b8;
    padding: 2rem;
}

.alert-info .btn-primary {
    margin-top: 1rem;
}

/* Remove top padding */
.container.mt-5.pt-5 {
    padding-top: 0 !important;
    margin-top: 0 !important;
}

/* Page Title */
.mb-4 {
    color: #2d3748;
    font-weight: 700;
    margin-bottom: 2rem !important;
}

/* Responsive */
@media (max-width: 768px) {
    .order-hero-title {
        font-size: 2.5rem;
    }
    
    .order-hero {
        height: 300px;
    }
    
    .table-header-cart th {
        padding: 1rem;
        font-size: 0.9rem;
    }
    
    .table tbody td {
        padding: 1rem;
    }
}

@media (max-width: 576px) {
    .order-hero-title {
        font-size: 2rem;
    }
    
    .order-hero {
        height: 250px;
    }
    
    .table-responsive {
        margin: 0 -15px;
        border-radius: 0;
    }
}
</style>


{% endblock %}